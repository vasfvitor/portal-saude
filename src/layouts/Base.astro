---
// Page shell: head tags (canonical, Open Graph, Twitter card, JSON-LD), header with the mark and the site
// nav, footer. Global CSS holds only tokens, reset, header, footer and type; pages and components keep their
// own scoped styles. Astro drops a line break between text and a tag: keep inline links on the same line.
import Logo from "../components/Logo.astro";
import { AUTHOR, DESCRIPTION, DISCLAIMER, NAME, pageTitle } from "../lib/brand";
import { ANS_URL, ANVISA_HUB_URL, HOME_URL, REPOS } from "../lib/config";

interface Props {
  title: string;
  description?: string;
  /** out of search engines (the error page) */
  noindex?: boolean;
  /** extra JSON-LD objects for the page, appended to the site's own */
  structured?: Record<string, unknown>[];
}
const { title, description = DESCRIPTION, noindex = false, structured = [] } = Astro.props;
const fullTitle = pageTitle(title);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
const site = Astro.site!.href;
const here = Astro.url.pathname;
const current = (path: string) => (here === path || (path !== "/" && here.startsWith(path)) ? "page" : undefined);
// JSON inside <script>: "</" must not appear raw
const jsonLd = (d: Record<string, unknown>) => JSON.stringify(d).replace(/</g, "\\u003c");
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site}#website`,
      url: site,
      name: NAME,
      description: DESCRIPTION,
      inLanguage: "pt-BR",
      publisher: { "@id": `${site}#org` },
    },
    {
      "@type": "Organization",
      "@id": `${site}#org`,
      name: AUTHOR.name,
      url: AUTHOR.url,
      sameAs: ["https://github.com/vasfvitor"],
    },
    ...structured,
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6faf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1413" media="(prefers-color-scheme: dark)" />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <meta name="robots" content="index, follow, max-image-preview:large" />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Seu plano de saúde, em dados abertos. ${NAME}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={jsonLd(graph)} />
  </head>
  <body>
    <a class="skip" href="#conteudo">
      Ir para o conteúdo
    </a>
    <header class="site">
      <a class="mark" href="/" aria-label="Início">
        <Logo />
        <span>{NAME}</span>
      </a>
      <nav aria-label="Seções">
        <a href="/plano/" aria-current={current("/plano/")}>
          Plano de saúde
        </a>
        <a href="/remedios/" aria-current={current("/remedios/")}>
          Remédios
        </a>
        <a href="/sobre/" aria-current={current("/sobre/")}>
          Sobre
        </a>
      </nav>
    </header>
    <main id="conteudo">
      <slot />
    </main>
    <footer class="site">
      <p class="aviso">
        {DISCLAIMER} <a href={ANS_URL}>gov.br/ans</a>
      </p>
      <nav aria-label="Projetos e código">
        <a href={REPOS.portal}>portal-saude</a>
        <a href={REPOS.ansFeeds}>ans-feeds</a>
        <a href={ANVISA_HUB_URL}>ANVISA em dados abertos</a>
        <a href={HOME_URL}>abelhaninja.de</a>
      </nav>
      <p class="licenca">
        Código MIT. Dados da ANS, sem alteração. <a href={AUTHOR.url}>{AUTHOR.name}</a>.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6faf9;
    --fg: #14211f;
    --muted: #5b6b68;
    --accent: #0f766e;
    --accent-ink: #0b5c56;
    --accent-soft: rgba(15, 118, 110, 0.1);
    --card: #ffffff;
    --line: #dbe5e3;
    --alert: #b42318;
    --alert-soft: rgba(180, 35, 24, 0.08);
    --good: #157a3a;
    --shadow: 0 1px 2px rgba(20, 33, 31, 0.06), 0 8px 24px rgba(20, 33, 31, 0.06);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0e1413;
      --fg: #e4ecea;
      --muted: #93a3a0;
      --accent: #2dd4bf;
      --accent-ink: #5eead4;
      --accent-soft: rgba(45, 212, 191, 0.1);
      --card: #151d1c;
      --line: #263331;
      --alert: #f87171;
      --alert-soft: rgba(248, 113, 113, 0.1);
      --good: #4ade80;
      --shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 8px 24px rgba(0, 0, 0, 0.35);
    }
  }
  * {
    box-sizing: border-box;
  }
  html {
    background: var(--bg) radial-gradient(80rem 26rem at 35% -8rem, var(--accent-soft), transparent 70%) no-repeat;
    color: var(--fg);
    font:
      17px/1.55 system-ui,
      -apple-system,
      "Segoe UI",
      Roboto,
      sans-serif;
    font-variant-numeric: tabular-nums;
  }
  body {
    margin: 0 auto;
    padding: 0 16px;
    max-width: 60rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  a {
    color: var(--fg);
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 1px;
  }
  a:hover,
  a:focus-visible {
    color: var(--accent-ink);
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .skip {
    position: absolute;
    left: -999px;
    top: 8px;
    background: var(--card);
    padding: 8px 12px;
  }
  .skip:focus {
    left: 16px;
  }
  header.site {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 18px 0;
  }
  header.site .mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 0;
    font-weight: 600;
  }
  header.site .mark svg {
    width: 36px;
    height: 36px;
  }
  header.site nav,
  footer.site nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
  }
  header.site nav a {
    border-bottom-color: transparent;
    font-weight: 500;
  }
  header.site nav a[aria-current="page"],
  header.site nav a:hover {
    border-bottom-color: var(--accent);
  }
  main {
    flex: 1;
  }
  h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    line-height: 1.1;
    margin: 2rem 0 0.75rem;
    letter-spacing: -0.02em;
  }
  h2 {
    font-size: 1.25rem;
    margin: 2.25rem 0 0.75rem;
  }
  h3 {
    font-size: 1.05rem;
    margin: 1.25rem 0 0.4rem;
  }
  p {
    margin: 0.5rem 0;
    max-width: 44rem;
  }
  .lead {
    color: var(--muted);
    font-size: 1.15rem;
    margin: 0 0 1.5rem;
  }
  .muted {
    color: var(--muted);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  footer.site {
    border-top: 1px solid var(--line);
    margin-top: 3rem;
    padding: 1.5rem 0 2rem;
    color: var(--muted);
    font-size: 0.9rem;
    display: grid;
    gap: 12px;
  }
  footer.site p {
    margin: 0;
  }
  footer.site .aviso {
    color: var(--fg);
  }
</style>
