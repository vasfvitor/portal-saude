---
// One page per operator: what happened to it (closed, portability), then the summary as the page itself: one
// block per subject, each opening onto its comparison with the base, and what to do after a problem. History, the
// feed and the sources sit in closed sections. Every number comes from the ans-feeds record; nothing is typed here.
import Acompanhar from "../../components/Acompanhar.astro";
import Frase from "../../components/Frase.astro";
import Quadro from "../../components/Quadro.astro";
import Secao from "../../components/Secao.astro";
import Serie from "../../components/Serie.astro";
import Base from "../../layouts/Base.astro";
import { ANS_CANAIS_URL, DADOS_URL, DISQUE_ANS, DISQUE_ANS_SURDOS, META_URL } from "../../lib/config";
import { fmtClientes, fmtDate, fmtMes } from "../../lib/format";
import {
  ACOMPANHAR_OPERADORA,
  ATUALIZACAO_ANS,
  fraseFalhas,
  NOMES_FONTE,
  cobertura,
  fraseAnoAnterior,
  fraseCancelamento,
  fraseIdss,
  fraseMetaRn623,
  frasePortabilidade,
  fraseReclamacoes,
  fraseRessarcimento,
  resumo,
  SINAIS_CONTEXTO,
  SINAIS_O_QUE_FAZER,
  sinaisDeDificuldade,
  type ItemResumo,
} from "../../lib/frases";
import {
  metaForBuild,
  nomeExibido,
  operadorasForBuild,
  paginaOperadora,
  type Operadora,
  type Reclamacoes,
} from "../../lib/operadoras";

export async function getStaticPaths() {
  const [ops, meta] = await Promise.all([operadorasForBuild(DADOS_URL, META_URL), metaForBuild(META_URL)]);
  const falhas = fraseFalhas(meta.falhas); // the same for every operator
  return ops.map((op) => ({
    params: { pagina: paginaOperadora(op).split("/")[2]! },
    props: { op, dia: meta.date, falhas },
  }));
}

interface Props {
  op: Operadora;
  dia: string;
  /** what the last ANS collection could not update, or null */
  falhas: string | null;
}
const { op, dia, falhas } = Astro.props;
const titulo = nomeExibido(op);
const cancelamento = fraseCancelamento(op);
const portabilidade = frasePortabilidade(op);
const ressarcimento = fraseRessarcimento(op.ressarcimento);
const sinais = sinaisDeDificuldade(op, dia);
const local = [op.municipio, op.uf].filter(Boolean).join("/");
const descricao = [
  `${op.nome}, registro ANS ${op.registro}.`,
  cancelamento ?? (op.reclamacoes[0] ? fraseReclamacoes(op.reclamacoes[0]).titulo : ""),
  "Dados públicos da ANS, com a fonte de cada número.",
]
  .filter(Boolean)
  .join(" ");
// One block per summary line. The complaint lines come first, one per coverage, in the order of op.reclamacoes;
// with no complaint data at all the block still says so.
interface Bloco {
  item: ItemResumo;
  id: string;
  reclamacoes?: Reclamacoes;
}
const itens = resumo(op);
const blocos: Bloco[] = itens.map((item, k) =>
  item.ancora === "reclamacoes"
    ? { item, id: k === 0 ? "reclamacoes" : `reclamacoes-${k + 1}`, reclamacoes: op.reclamacoes[k]! }
    : { item, id: item.ancora },
);
if (op.reclamacoes.length === 0) {
  blocos.unshift({
    item: { assunto: "Reclamações", texto: "sem dado", tom: "sem-base", ancora: "reclamacoes" },
    id: "reclamacoes",
  });
}
const ultimaReclamacao = blocos.findLastIndex((b) => b.item.ancora === "reclamacoes");
const breadcrumb = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Plano de saúde", item: new URL("/plano/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: titulo, item: new URL(Astro.url.pathname, Astro.site).href },
  ],
};
---

<Base
  title={titulo}
  description={descricao}
  structured={[breadcrumb]}
  feed={op.feed ? { href: op.feed, title: `${titulo}: avisos da ANS` } : undefined}
>
  <p class="trilha">
    <a href="/plano/">Plano de saúde</a> › {titulo}
  </p>
  <h1>{titulo}</h1>
  <p class="ficha">
    <span>{op.modalidade}</span>
    {local && <span>{local}</span>}
    {op.beneficiarios !== null && (
      <span>
        {op.beneficiarios_em
          ? `${fmtClientes(op.beneficiarios)} em ${fmtMes(op.beneficiarios_em)}`
          : fmtClientes(op.beneficiarios)}
      </span>
    )}
  </p>

  {cancelamento && (
    <Quadro tipo="alerta" titulo="Esta operadora foi fechada">
      <p>{cancelamento}</p>
      {!portabilidade && (
        <p>
          <a href="/plano/portabilidade/">Quando dá para trocar de plano sem carência</a>
        </p>
      )}
    </Quadro>
  )}
  {portabilidade && (
    <Quadro tipo="destaque" titulo="Pode trocar de plano sem carência">
      <p>{portabilidade}</p>
      <p>
        <a href="/plano/portabilidade/">Como pedir a troca</a>
        {op.portabilidade_vigente[0]?.link && (
          <>
            {" "}
            · <a href={op.portabilidade_vigente[0].link}>texto da Resolução</a>
          </>
        )}
      </p>
    </Quadro>
  )}
  {sinais.length > 0 && (
    <Quadro tipo="atencao" titulo="Sinais de dificuldade">
      <ul>
        {sinais.map((s) => (
          <li>{s}</li>
        ))}
      </ul>
      <details class="o-que-fazer">
        <summary>O que isso quer dizer</summary>
        <p>{SINAIS_CONTEXTO}</p>
        <p>
          {SINAIS_O_QUE_FAZER} <a href="/plano/portabilidade/">Quando dá para trocar de plano sem carência</a>
          {op.feed && (
            <>
              {" "}
              · <a href="#acompanhar">Receber aviso quando a ANS publicar algo</a>
            </>
          )}
        </p>
      </details>
    </Quadro>
  )}

  <h2 class="sr-only">Em resumo</h2>
  <div class="blocos">
    {blocos.map(({ item, id, reclamacoes }, k) => (
      <details class={`bloco ${item.tom}`} id={id}>
        <summary>
          <span class="assunto">{item.assunto}</span>
          <span class="texto">{item.texto}</span>
        </summary>
        <div class="dentro">
          {item.ancora === "reclamacoes" &&
            (reclamacoes ? (
              <>
                {op.reclamacoes.length > 1 && <h3>{cobertura(reclamacoes.cobertura)}</h3>}
                <Frase frase={fraseReclamacoes(reclamacoes)}>
                  {fraseAnoAnterior(reclamacoes.serie) && <p class="detalhe">{fraseAnoAnterior(reclamacoes.serie)}</p>}
                  <Serie
                    serie={reclamacoes.serie}
                    mediana={reclamacoes.mediana_mesmo_porte}
                    tom={fraseReclamacoes(reclamacoes).tom}
                  />
                </Frase>
              </>
            ) : (
              <p class="muted">Sem dado de reclamações para esta operadora.</p>
            ))}
          {k === ultimaReclamacao && op.meta_rn623 && (
            <p>
              {fraseMetaRn623(op.meta_rn623)}
              {op.meta_rn623.listas.map((url, i) => (
                <>
                  {" "}
                  <a href={url}>
                    {`Lista oficial${op.meta_rn623!.listas.length > 1 ? ` ${i + 1}` : ""} da ANS deste trimestre (PDF)`}
                  </a>
                </>
              ))}
            </p>
          )}
          {item.ancora === "nota" && <Frase frase={fraseIdss(op.idss, op.modalidade)} />}
          {item.ancora === "sus" && ressarcimento && <Frase frase={ressarcimento} />}
        </div>
      </details>
    ))}

    <details class="bloco ajuda" id="problema">
      <summary>
        <span class="assunto">Teve problema?</span>
        <span class="texto">o que fazer</span>
      </summary>
      <div class="dentro">
        <ol>
          <li>Reclame primeiro na operadora e anote o número do protocolo.</li>
          <li>
            Se não resolver, reclame na ANS: pelo Disque ANS, {DISQUE_ANS} (ligação gratuita, de segunda a sexta, das 8h
            às 20h; para pessoas surdas, {DISQUE_ANS_SURDOS}), ou pelos{" "}
            <a href={ANS_CANAIS_URL}>canais da ANS na internet</a>. Informe o protocolo da operadora.
          </li>
          <li>
            A ANS cobra uma resposta da operadora: até 5 dias úteis quando o problema é de cobertura (exame, consulta,
            cirurgia) e até 10 nos outros casos.
          </li>
        </ol>
        {op.situacao === "cancelada" && (
          <p>
            Como a operadora foi fechada, pergunte também à ANS como fica o seu atendimento e se há portabilidade para
            outro plano.
          </p>
        )}
      </div>
    </details>
  </div>

  <div class="secoes">
    {op.eventos.length > 0 && (
      <Secao titulo="Histórico" extra={String(op.eventos.length)} id="historico">
        <ul class="eventos">
          {op.eventos.map((e) => (
            <li>
              <span class="quando">{fmtDate(e.data)}</span> {e.titulo}
            </li>
          ))}
        </ul>
      </Secao>
    )}

    {op.feed && (
      <Acompanhar
        titulo="Receber aviso quando a ANS publicar algo"
        avisa={ACOMPANHAR_OPERADORA}
        href={op.feed}
        rotulo="Endereço do feed desta operadora"
      />
    )}

    <Secao titulo="Fontes" id="fontes">
      <p>
        {titulo !== op.nome && `Razão social: ${op.nome}. `}Registro ANS {op.registro}. Dados da ANS coletados em{" "}
        {fmtDate(dia)}. {ATUALIZACAO_ANS} Todos os números desta página, num arquivo só:{" "}
        <a href={`${DADOS_URL}/operadora/${op.registro}.json`}>JSON</a>.
      </p>
      {falhas && <p class="muted">{falhas}</p>}
      <ul>
        {Object.entries(op.fontes)
          .filter(([, url]) => url)
          .map(([k, url]) => (
            <li>
              <a href={url}>{NOMES_FONTE[k] ?? k}</a>
            </li>
          ))}
      </ul>
      {op.fora.length > 0 && (
        <>
          <p class="muted">Ficaram de fora porque a ANS parou de atualizar:</p>
          <ul class="muted">
            {op.fora.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </>
      )}
    </Secao>
  </div>
</Base>

<style>
  .o-que-fazer summary {
    cursor: pointer;
    min-height: 32px;
    text-decoration: underline 2px var(--accent);
    text-underline-offset: 3px;
  }
  .ficha {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .blocos {
    margin: 1.25rem 0 0;
  }
  .bloco {
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 4px solid var(--line);
    border-radius: 10px;
    margin: 8px 0;
    padding: 0 14px;
    scroll-margin-top: 1rem;
  }
  .bloco.favoravel {
    border-left-color: var(--good);
  }
  .bloco.desfavoravel {
    border-left-color: var(--alert);
  }
  .bloco.neutro {
    border-left-color: var(--neutral);
  }
  .bloco.ajuda {
    border-left-color: var(--accent);
  }
  summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 12px;
    min-height: 56px;
    padding: 10px 28px 10px 0;
    cursor: pointer;
    list-style: none;
    position: relative;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* a chevron that points down when closed and up when open */
  summary::after {
    content: "";
    position: absolute;
    right: 4px;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -6px;
    border-right: 2px solid var(--accent-ink);
    border-bottom: 2px solid var(--accent-ink);
    transform: rotate(45deg);
  }
  .bloco[open] summary::after {
    margin-top: -2px;
    transform: rotate(-135deg);
  }
  .assunto {
    font-size: 0.85rem;
    color: var(--muted);
    flex-basis: 100%;
  }
  .texto {
    font-weight: 600;
  }
  .dentro {
    border-top: 1px solid var(--line);
    padding: 4px 0 12px;
  }
  .dentro :global(.frase) {
    border: 0;
    padding: 0;
    margin: 0.5rem 0 0;
  }
  .detalhe {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0.4rem 0 0;
  }
  .eventos {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .eventos li {
    padding: 6px 0;
    border-bottom: 1px solid var(--line);
  }
  .quando {
    color: var(--muted);
    margin-right: 6px;
  }
</style>
