---
// One page per substância: first the same dose and package side by side (every product that sells it, cheapest
// first in the reader's ICMS regime), then every product grouped by type. Comparing ranges across doses misleads,
// so prices only appear next to the same dose and package. Each row carries its rank in both regimes; CSS in
// Base.astro reorders, highlights and cuts the list once the reader picks a state.
import Acompanhar from "../../../components/Acompanhar.astro";
import Selo from "../../../components/Selo.astro";
import SeuEstado from "../../../components/SeuEstado.astro";
import Base from "../../../layouts/Base.astro";
import { ehGenerico, porChave, quantoMenos, REGIMES, type Opcao } from "../../../lib/comparar";
import { CMED_DADOS_URL } from "../../../lib/config";
import { contar, fmtMoney } from "../../../lib/format";
import { acompanharSubstancia, aliquotaRotulo, precosPorAliquota, tipoExplicado } from "../../../lib/frases-remedios";
import { TABELA, type Regime } from "../../../lib/icms";
import { paginaProduto, produtosForBuild, slugsSubstancias, type Produto } from "../../../lib/remedios";

export async function getStaticPaths() {
  const produtos = await produtosForBuild(CMED_DADOS_URL);
  const slugs = slugsSubstancias(produtos.map((p) => p.substancia));
  const por = new Map<string, Produto[]>();
  for (const p of produtos) {
    const lista = por.get(p.substancia) ?? [];
    lista.push(p);
    por.set(p.substancia, lista);
  }
  return [...por.entries()].map(([substancia, lista]) => ({
    params: { slug: slugs.get(substancia)! },
    props: { substancia, lista },
  }));
}

interface Props {
  substancia: string;
  lista: Produto[];
}
const { substancia, lista } = Astro.props;
const ref = TABELA.ref;
const ufsRef = TABELA.ufs.normal.get(ref) ?? [];
const MAX_LINHAS = 8;

interface Linha {
  o: Opcao;
  /** rank in each regime (99 when absent), whether it is the cheapest, past the cut, and % below the reference */
  ordem: Record<Regime, number>;
  menor: Regime[];
  fora: Regime[];
  menos: Partial<Record<Regime, number>>;
}

// the same dose and package sold by two or more products, the most offered first
const porRegime = { p: porChave(lista, "p"), g: porChave(lista, "g") };
const id = (o: Opcao) => `${o.produto.registro_produto}|${o.apresentacao.ggrem}`;
const grupos = [...porRegime.p.entries()]
  .filter(([, opcoes]) => new Set(opcoes.map((o) => o.produto.registro_produto)).size >= 2)
  .map(([chave, opcoesP]) => {
    const opcoes = { p: opcoesP, g: porRegime.g.get(chave) ?? opcoesP };
    const posicao = { p: new Map(opcoes.p.map((o, i) => [id(o), i])), g: new Map(opcoes.g.map((o, i) => [id(o), i])) };
    const referencia = (r: Regime) => opcoes[r].find((o) => o.produto.tipo_produto === "Novo");
    const linhas = new Map<string, Linha>();
    for (const r of REGIMES) {
      for (const o of opcoes[r].slice(0, MAX_LINHAS)) {
        if (linhas.has(id(o))) continue;
        const ordem = { p: posicao.p.get(id(o)) ?? 99, g: posicao.g.get(id(o)) ?? 99 };
        const menos: Linha["menos"] = {};
        for (const rr of REGIMES) {
          const novo = referencia(rr);
          const preco = opcoes[rr][ordem[rr]]?.preco;
          if (novo && preco !== undefined && preco < novo.preco) menos[rr] = quantoMenos(novo.preco, preco);
        }
        linhas.set(id(o), {
          o,
          ordem,
          menor: REGIMES.filter((rr) => ordem[rr] === 0),
          fora: REGIMES.filter((rr) => ordem[rr] >= MAX_LINHAS),
          menos,
        });
      }
    }
    return {
      legivel: opcoesP[0]!.lida.legivel,
      linhas: [...linhas.values()].sort((a, b) => a.ordem.p - b.ordem.p),
      alem: opcoesP.length - MAX_LINHAS,
    };
  })
  .sort((a, b) => b.linhas.length - a.linhas.length || a.legivel.localeCompare(b.legivel, "pt-BR"));

const nome = (p: Produto) => (p.produto === p.substancia ? p.laboratorio : p.produto);
const detalhe = (p: Produto) => (p.produto === p.substancia ? null : p.laboratorio);
const menosTexto = (n: number | undefined) => (n !== undefined && n >= 1 ? `${n}% menos` : "");

const ORDEM = ["Novo", "Genérico", "Similar", "Biológico", "Específico", "Fitoterápico"];
const posicao = (t: string) => (ORDEM.includes(t) ? ORDEM.indexOf(t) : ORDEM.length);
const tipos = [...new Set(lista.map((p) => p.tipo_produto ?? "Outro"))].sort(
  (a, b) => posicao(a) - posicao(b) || a.localeCompare(b),
);
const doTipo = (t: string) =>
  lista
    .filter((p) => (p.tipo_produto ?? "Outro") === t)
    .sort((a, b) => Number(b.comercializado) - Number(a.comercializado) || nome(a).localeCompare(nome(b), "pt-BR"));
const temGenerico = lista.some(ehGenerico);
// the reference product(s) the "% menos" is measured against, named when there is only one
const referencias = [...new Set(lista.filter((p) => p.tipo_produto === "Novo").map((p) => p.produto))];
// every product with the substância carries the same feed address
const feed = lista.find((p) => p.feed_substancia)?.feed_substancia ?? null;
const resumo = `${contar(lista.length, "produto tem", "produtos têm")} esta substância${temGenerico ? ", entre marcas e genéricos" : ""}.`;
---

<Base
  title={`${substancia}: marcas, genéricos e preço máximo`}
  description={`${contar(lista.length, "produto", "produtos")} com ${substancia} na lista da CMED, com o preço máximo de cada dose e embalagem lado a lado.`}
  feed={feed ? { href: feed, title: `${substancia}: preços da CMED` } : undefined}
>
  <p class="trilha">
    <a href="/remedios/">Remédios</a> › Substância
  </p>
  <h1>{substancia}</h1>
  <p class="lead">
    {resumo}
    {grupos.length > 0 && " Para comparar preço, compare a mesma dose e embalagem."}
  </p>

  {grupos.length > 0 && (
    <section>
      <SeuEstado />
      <h2>A mesma dose e embalagem, do mais barato ao mais caro</h2>
      <p class="muted">
        Preço máximo: <span data-uf-rotulo>{`ICMS de ${aliquotaRotulo(ref)} (${ufsRef.join(", ")})`}</span>. Só entram
        remédios com venda no último ano.{" "}
        {referencias.length === 1
          ? `O "% menos" é em relação ao ${referencias[0]}, o remédio de referência, no mesmo estado.`
          : 'O "% menos" é em relação ao remédio de referência (o "Novo"), no mesmo estado.'}
      </p>
      {grupos.map(({ legivel, linhas, alem }) => (
        <div class="cartao">
          <h3>{legivel}</h3>
          <ol class="linhas">
            {linhas.map(({ o, ordem, menor, fora, menos }) => (
              <li
                style={`--ordem: ${ordem.p}; --ordem-g: ${ordem.g}`}
                data-menor={menor.join(" ") || undefined}
                data-fora={fora.join(" ") || undefined}
                data-generico={ehGenerico(o.produto) ? "1" : "0"}
              >
                <span class="quem">
                  <a href={paginaProduto(o.produto)}>{nome(o.produto)}</a>
                  {detalhe(o.produto) && <span class="lab">{detalhe(o.produto)}</span>}
                </span>
                <span>{o.produto.tipo_produto && <Selo>{o.produto.tipo_produto}</Selo>}</span>
                <span class="valor">
                  <strong data-precos={precosPorAliquota(o.apresentacao.pmc)}>
                    {fmtMoney(o.apresentacao.pmc[ref] ?? o.preco)}
                  </strong>
                  {menos.p === menos.g
                    ? menosTexto(menos.p) && <small>{menosTexto(menos.p)}</small>
                    : REGIMES.map(
                        (r) => menosTexto(menos[r]) && <small data-so-regime={r}>{menosTexto(menos[r])}</small>,
                      )}
                </span>
              </li>
            ))}
          </ol>
          {alem > 0 && <p class="muted mais">E mais {alem}, mais caros. Estão na lista completa abaixo.</p>}
        </div>
      ))}
    </section>
  )}

  <section>
    <h2>Todos os produtos com esta substância</h2>
    {tipos.map((t) => (
      <>
        <h3>{t}</h3>
        {tipoExplicado(t) && <p class="muted">{tipoExplicado(t)}</p>}
        <ul class="produtos">
          {doTipo(t).map((p) => (
            <li>
              <a href={paginaProduto(p)}>{nome(p)}</a>
              <span class="muted">
                {detalhe(p) && ` · ${detalhe(p)}`} ·{" "}
                {contar(p.apresentacoes.length, "dose e embalagem", "doses e embalagens")}
              </span>
              {!p.comercializado && <Selo tom="atencao">sem venda no último ano</Selo>}
            </li>
          ))}
        </ul>
      </>
    ))}
  </section>

  {feed && (
    <Acompanhar
      titulo="Acompanhar os preços"
      avisa={acompanharSubstancia(substancia)}
      href={feed}
      rotulo={`Endereço do feed de ${substancia}`}
    />
  )}
</Base>

<style>
  .quem {
    display: flex;
    flex-direction: column;
  }
  .quem a {
    align-self: flex-start;
  }
  .lab {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .valor {
    text-align: right;
    white-space: nowrap;
    display: flex;
    flex-direction: column;
  }
  .valor small {
    color: var(--good);
    font-size: 0.78rem;
  }
  .mais {
    margin: 0.4rem 0 0;
    font-size: 0.9rem;
  }
  .produtos {
    padding-left: 1.1rem;
  }
  .produtos li {
    margin: 6px 0;
  }
  @media (max-width: 30rem) {
    .linhas > li {
      grid-template-columns: 1fr auto;
    }
    .linhas > li > :nth-child(2) {
      grid-column: 1;
      grid-row: 2;
    }
    .valor {
      grid-row: 1 / span 2;
      grid-column: 2;
    }
  }
</style>
