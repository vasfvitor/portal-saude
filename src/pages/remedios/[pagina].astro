---
// One page per product: a one-line warning when there is something to check, then one table with the maximum
// price of each dose and package at the reference rate (the picker swaps in the reader's state) next to the
// cheapest product with the same dose and package. Everything that is not that answer sits in closed sections:
// the price in every state, the product's facts, the rules behind a price, the feed and the sources. A price is
// never shown without its rate or its state next to it.
import Acompanhar from "../../components/Acompanhar.astro";
import Quadro from "../../components/Quadro.astro";
import Secao from "../../components/Secao.astro";
import Selo from "../../components/Selo.astro";
import SeuEstado from "../../components/SeuEstado.astro";
import TabelaPrecos, { type Barato, type Linha } from "../../components/TabelaPrecos.astro";
import Base from "../../layouts/Base.astro";
import { lerApresentacao } from "../../lib/apresentacao";
import {
  chaveComparacao,
  ehGenerico,
  maisBarato,
  porChave,
  precoNoRegime,
  quantoMenos,
  REGIMES,
} from "../../lib/comparar";
import { CMED_DADOS_URL } from "../../lib/config";
import { contar, fmtStamp } from "../../lib/format";
import {
  acompanharSubstancia,
  aliquotaRotulo,
  ATUALIZACAO_CMED,
  avisoComercializacao,
  avisoProduto,
  classeSemCodigo,
  EMBALAGEM_INSTITUCIONAL,
  embalagemInstitucional,
  EMBALAGENS_INSTITUCIONAIS,
  fraseMedida,
  fraseRegistro,
  REGISTRO_NAO_CONFERIDO,
  ISENTO_DE_ICMS,
  MEDIDAS_SEM_LOTE,
  PRECO_MAXIMO,
  PRECO_MAXIMO_CURTO,
  precoMaximo,
  precoPorUnidade,
  REGISTRO_INATIVO,
  SE_COBRAREM_MAIS,
  tarjaExplicada,
  TROCA_NA_FARMACIA,
  tipoExplicado,
  USO_HOSPITALAR,
} from "../../lib/frases-remedios";
import { TABELA } from "../../lib/icms";
import {
  paginaProduto,
  pmcAplicavel,
  produtosForBuild,
  slugsSubstancias,
  type Apresentacao,
  type Produto,
} from "../../lib/remedios";

export async function getStaticPaths() {
  const produtos = await produtosForBuild(CMED_DADOS_URL);
  const substancias = slugsSubstancias(produtos.map((p) => p.substancia));
  const grupos = { p: porChave(produtos, "p"), g: porChave(produtos, "g") };
  const baratos = (p: Produto, a: Apresentacao): Barato[] => {
    const lida = lerApresentacao(a.apresentacao);
    if (!lida) return [];
    const porRegime = REGIMES.flatMap((regime): Barato[] => {
      const preco = precoNoRegime(p, a, regime);
      const o =
        preco === undefined
          ? undefined
          : // not on sale: the cheapest alternative on sale, even if it costs more
            maisBarato(
              grupos[regime].get(chaveComparacao(p, lida)),
              p.registro_produto,
              a.comercializado ? preco : undefined,
            );
      if (!o || preco === undefined) return [];
      const { produto } = o;
      return [
        {
          regime,
          produto: produto.produto,
          laboratorio: produto.laboratorio,
          tipo: produto.tipo_produto,
          href: paginaProduto(produto),
          pmc: pmcAplicavel(o.apresentacao),
          menos: quantoMenos(preco, o.preco),
          alternativa: !a.comercializado,
          isento: o.apresentacao.icms_0,
        },
      ];
    });
    // the same answer in both regimes is shown once, for every state
    const [x, y] = porRegime;
    return x && y && x.href === y.href && x.menos === y.menos ? [{ ...x, regime: undefined }] : porRegime;
  };
  return produtos.map((p) => ({
    params: { pagina: paginaProduto(p).split("/")[2]! },
    props: { p, substanciaSlug: substancias.get(p.substancia)!, baratos: p.apresentacoes.map((a) => baratos(p, a)) },
  }));
}

interface Props {
  p: Produto;
  substanciaSlug: string;
  baratos: Barato[][];
}
const { p, substanciaSlug, baratos } = Astro.props;
const generico = ehGenerico(p);
const marca = generico ? "1" : "0";
const ufs = generico ? TABELA.ufs.generico : TABELA.ufs.normal;
const cols = generico ? TABELA.colunas.generico : TABELA.colunas.normal;
const ref = TABELA.ref;
const rotuloRef = `ICMS de ${aliquotaRotulo(ref)} (${ufs.get(ref)?.join(", ") ?? ""})`;
// exempt from ICMS everywhere: no line per state, so neither the picker nor the "a confirmar" note has a job
const porEstado = p.apresentacoes.some((a) => !a.icms_0);
const aConfirmar = porEstado && [...ufs.values()].flat().some((u) => u.endsWith("*"));
const tipo = tipoExplicado(p.tipo_produto);
const tarja = tarjaExplicada(p.tarja);
const aviso = avisoProduto(p);
const semVenda = avisoComercializacao(p.comercializado);
const alternativa = baratos.some((b) => b.some((x) => x.alternativa));
const temBarato = baratos.some((b) => b.length > 0);

// Presentations that differ only in what the list says about the blister (the same dose and package, the same
// prices) are one row; the official texts of all of them stay in "Preço em cada estado".
interface Grupo extends Linha {
  codigos: string[];
  inst: boolean;
}
const grupos = new Map<string, Grupo>();
p.apresentacoes.forEach((a, i) => {
  const nome = lerApresentacao(a.apresentacao)?.legivel ?? a.apresentacao;
  const chave = JSON.stringify([nome, a.pmc, a.icms_0, a.comercializado, a.restricao_hospitalar]);
  const ja = grupos.get(chave);
  if (ja) ja.codigos.push(a.apresentacao);
  else
    grupos.set(chave, {
      a,
      nome,
      baratos: baratos[i]!,
      semVenda: p.comercializado && !a.comercializado,
      codigos: [a.apresentacao],
      inst: embalagemInstitucional(a),
    });
});
// boxes for the reader first, then the hospital and fractioned-sale ones in a section of their own
const paraVoce = [...grupos.values()].filter((l) => !l.inst);
const institucionais = [...grupos.values()].filter((l) => l.inst);
const comEstados = [...paraVoce, ...institucionais].filter((l) => !l.a.icms_0);

const publicado = fmtStamp(p.stamp);
const primeira = lerApresentacao(p.apresentacoes[0]!.apresentacao)?.legivel ?? p.apresentacoes[0]!.apresentacao;
const descricao = `${p.produto} (${p.laboratorio}), ${primeira}: quanto a farmácia pode cobrar em cada estado, na lista da CMED de ${publicado}.`;
const breadcrumb = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Remédios", item: new URL("/remedios/", Astro.site).href },
    {
      "@type": "ListItem",
      position: 2,
      name: p.substancia,
      item: new URL(`/remedios/substancia/${substanciaSlug}/`, Astro.site).href,
    },
    { "@type": "ListItem", position: 3, name: p.produto, item: new URL(Astro.url.pathname, Astro.site).href },
  ],
};
---

<Base
  title={`${p.produto}: preço máximo`}
  description={descricao}
  structured={[breadcrumb]}
  feed={p.feed_substancia ? { href: p.feed_substancia, title: `${p.substancia}: preços da CMED` } : undefined}
>
  <p class="trilha">
    <a href="/remedios/">Remédios</a> › <a href={`/remedios/substancia/${substanciaSlug}/`}>{p.substancia}</a>
  </p>
  <h1>{p.produto}</h1>
  <p class="ficha">
    {p.laboratorio}
    {p.tipo_produto && <Selo>{p.tipo_produto}</Selo>}
  </p>

  {aviso && (
    <Quadro tipo={aviso.tom}>
      <p class="aviso">{aviso.resumo}</p>
      <details class="o-que-fazer">
        <summary>O que fazer</summary>
        {p.situacao && !p.situacao.ativo && <p>{REGISTRO_INATIVO}</p>}
        {semVenda && (
          <p>
            {semVenda}
            {alternativa &&
              " Na tabela de preços aparece um remédio com a mesma substância, dose e embalagem que teve venda no último ano."}
          </p>
        )}
        {p.medidas.length > 0 && (
          <>
            <ul>
              {p.medidas.map((m) => (
                <li>
                  {fraseMedida(m)}
                  {m.processo && <span class="muted"> Processo {m.processo}.</span>}
                </li>
              ))}
            </ul>
            <p>{MEDIDAS_SEM_LOTE}</p>
          </>
        )}
      </details>
    </Quadro>
  )}

  {porEstado && <SeuEstado />}

  {paraVoce.length > 0 && (
    <section data-generico={marca}>
      <h2>Preço máximo</h2>
      <p class="muted">
        {PRECO_MAXIMO_CURTO}{" "}
        {porEstado ? (
          <>
            Na tabela: <span data-uf-rotulo>{rotuloRef}</span>.
          </>
        ) : (
          ISENTO_DE_ICMS
        )}
      </p>
      <TabelaPrecos linhas={paraVoce} marca={marca} />
    </section>
  )}

  <div class="secoes">
    {institucionais.length > 0 && (
      <Secao
        titulo={EMBALAGENS_INSTITUCIONAIS}
        extra={contar(institucionais.length, "dose e embalagem", "doses e embalagens")}
        aberta={paraVoce.length === 0}
        id="institucionais"
      >
        <p class="muted">{EMBALAGEM_INSTITUCIONAL}</p>
        {institucionais.some((l) => l.a.restricao_hospitalar) && <p class="muted">{USO_HOSPITALAR}</p>}
        <TabelaPrecos linhas={institucionais} marca={marca} />
      </Secao>
    )}

    {comEstados.length > 0 && (
      <Secao titulo="Preço em cada estado" extra="e por unidade" id="estados">
        <div data-generico={marca}>
          {comEstados.map(({ a, nome, codigos }) => {
            const u = lerApresentacao(a.apresentacao)?.unidade;
            return (
              <>
                <h3>{nome}</h3>
                <p class="codigo">Como está na lista oficial: {codigos.join("; ")}</p>
                <ul class="linhas">
                  {cols
                    .filter((k) => a.pmc[k] !== undefined)
                    .map((k) => (
                      <li data-aliquota={k}>
                        <span class="ufs">{ufs.get(k)?.join(", ") ?? "nenhum estado como padrão"}</span>
                        <span class="icms">ICMS {aliquotaRotulo(k)}</span>
                        <span class="valor">
                          <strong>{precoMaximo(a.pmc, k)}</strong>
                          {u && <small>{precoPorUnidade(a.pmc[k]!, u)}</small>}
                        </span>
                      </li>
                    ))}
                </ul>
              </>
            );
          })}
          {aConfirmar && <p class="muted">* Estado com ICMS confirmado só por fontes não oficiais.</p>}
        </div>
      </Secao>
    )}

    <Secao titulo="Sobre este remédio" id="sobre">
      <ul>
        {tipo && <li>{tipo}</li>}
        {tarja && <li>{tarja}</li>}
        <li>
          Substância: <a href={`/remedios/substancia/${substanciaSlug}/`}>{p.substancia}</a>, com as outras marcas e os
          genéricos
        </li>
        {p.classe_terapeutica && <li>Grupo de remédios: {classeSemCodigo(p.classe_terapeutica)}</li>}
        <li>{fraseRegistro(p.registro_produto, p.situacao)}</li>
        {p.situacaoConferida === false && <li class="muted">{REGISTRO_NAO_CONFERIDO}</li>}
      </ul>
    </Secao>

    <Secao titulo="Antes de comprar" extra={temBarato ? "troca, Procon" : "Procon"} id="antes">
      <p>{PRECO_MAXIMO}</p>
      {temBarato && <p>{TROCA_NA_FARMACIA}</p>}
      <p>{SE_COBRAREM_MAIS}</p>
      <p class="muted">{ATUALIZACAO_CMED}</p>
    </Secao>

    {p.feed_substancia && (
      <Acompanhar
        titulo="Receber aviso quando o preço mudar"
        avisa={acompanharSubstancia(p.substancia)}
        href={p.feed_substancia}
        rotulo={`Endereço do feed de ${p.substancia}`}
      />
    )}

    <Secao titulo="Fontes" id="fontes">
      <p>
        Lista de preços da CMED (ANVISA), publicada em {publicado}. O ICMS de cada estado e a lei de origem estão em{" "}
        <a href="/remedios/sobre-o-preco/">por que o preço muda de estado para estado</a>. Todos os números deste
        remédio, num arquivo só: <a href={`${CMED_DADOS_URL}/produto/${p.registro_produto}.json`}>JSON</a>.
      </p>
    </Secao>
  </div>
</Base>

<style>
  .ficha {
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 0;
  }
  .aviso {
    font-weight: 600;
  }
  .o-que-fazer summary {
    cursor: pointer;
    min-height: 32px;
    text-decoration: underline 2px var(--accent);
    text-underline-offset: 3px;
  }
  .codigo {
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0 0 0.25rem;
  }
  .ufs {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .icms {
    font-size: 0.85rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .valor {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .valor strong {
    white-space: nowrap;
  }
  .valor small {
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
