---
// One page per product: what it is, then one block per dose and package with the maximum price in each state
// (a line per ICMS rate, with the states that use it), the price in the reader's state once they pick it, and the
// cheapest product with the same dose and package. Prices come from the CMED list as published; a price is never
// shown without its rate or its state next to it.
import Quadro from "../../components/Quadro.astro";
import Selo from "../../components/Selo.astro";
import SeuEstado from "../../components/SeuEstado.astro";
import Base from "../../layouts/Base.astro";
import { lerApresentacao } from "../../lib/apresentacao";
import { maisBarato, porChave, quantoMenos } from "../../lib/comparar";
import { CMED_DADOS_URL } from "../../lib/config";
import { fmtDate, fmtMoney } from "../../lib/format";
import {
  aliquotaRotulo,
  avisoComercializacao,
  classeSemCodigo,
  faixaPreco,
  PRECO_MAXIMO,
  SE_COBRAREM_MAIS,
  tarjaExplicada,
  tipoExplicado,
} from "../../lib/frases-remedios";
import { aliquotaPorUf, aliquotaReferencia, colunas, ufsPorAliquota } from "../../lib/icms";
import {
  paginaProduto,
  produtosForBuild,
  slugsSubstancias,
  type Aliquota,
  type Apresentacao,
  type Produto,
} from "../../lib/remedios";

interface Barato {
  produto: string;
  laboratorio: string;
  tipo: string | null;
  href: string;
  pmc: Apresentacao["pmc"];
  /** whole percent less at the comparison rate, and in each state (generics pay less ICMS in some states) */
  menos: number;
  menosPorUf: Record<string, number>;
}

export async function getStaticPaths() {
  const produtos = await produtosForBuild(CMED_DADOS_URL);
  const substancias = slugsSubstancias(produtos.map((p) => p.substancia));
  const ref = aliquotaReferencia().aliquota;
  const grupos = porChave(produtos, ref);
  return produtos.map((p) => ({
    params: { pagina: paginaProduto(p).split("/")[2]! },
    props: {
      p,
      substanciaSlug: substancias.get(p.substancia)!,
      baratos: p.apresentacoes.map((a): Barato | null => {
        const lida = lerApresentacao(a.apresentacao);
        const preco = a.pmc[ref];
        if (!lida || preco === undefined) return null;
        const o = maisBarato(grupos.get(lida.chave), p.registro_produto, preco);
        if (!o) return null;
        const meu = aliquotaPorUf(p.tipo_produto === "Genérico");
        const dele = aliquotaPorUf(o.produto.tipo_produto === "Genérico");
        const menosPorUf: Record<string, number> = {};
        for (const uf of Object.keys(meu)) {
          const de = a.pmc[meu[uf]!];
          const para = o.apresentacao.pmc[dele[uf]!];
          // -1: in this state the other option is not cheaper (it pays a higher ICMS than this generic)
          if (de !== undefined && para !== undefined) menosPorUf[uf] = para < de ? quantoMenos(de, para) : -1;
        }
        return {
          produto: o.produto.produto,
          laboratorio: o.produto.laboratorio,
          tipo: o.produto.tipo_produto,
          href: paginaProduto(o.produto),
          pmc: o.apresentacao.pmc,
          menos: quantoMenos(preco, o.preco),
          menosPorUf,
        };
      }),
    },
  }));
}

interface Props {
  p: Produto;
  substanciaSlug: string;
  baratos: (Barato | null)[];
}
const { p, substanciaSlug, baratos } = Astro.props;
const generico = p.tipo_produto === "Genérico";
const ufs = ufsPorAliquota(undefined, generico);
const aConfirmar = [...ufs.values()].flat().some((u) => u.endsWith("*"));
// only the rates some state uses for this product (generics move SP and MG to 12%)
const cols = ufs.size > 0 ? colunas().filter((a) => ufs.has(a)) : colunas();
const ref = aliquotaReferencia().aliquota;
const tipo = tipoExplicado(p.tipo_produto);
const tarja = tarjaExplicada(p.tarja);
const aviso = avisoComercializacao(p.comercializado);
const publicado = fmtDate(`${p.stamp.slice(0, 4)}-${p.stamp.slice(4, 6)}-${p.stamp.slice(6, 8)}`);
const precos = (pmc: Apresentacao["pmc"]) =>
  JSON.stringify(
    Object.fromEntries(
      Object.entries(pmc)
        .filter(([k]) => k !== "0")
        .map(([k, c]) => [k, fmtMoney(c)]),
    ),
  );
const maisBaratoRotulo = (n: number) =>
  n >= 1 ? `Até ${n}% mais barato` : n === 0 ? "Um pouco mais barato" : "Outra opção";
// only the states where the label differs from the one shown without a state
const rotulosPorUf = (por: Record<string, number>, padrao: number) =>
  Object.fromEntries(
    Object.entries(por)
      .filter(([, n]) => maisBaratoRotulo(n) !== maisBaratoRotulo(padrao))
      .map(([uf, n]) => [uf, maisBaratoRotulo(n)]),
  );
const preco = (pmc: Apresentacao["pmc"], k: Aliquota) => (pmc[k] === undefined ? null : fmtMoney(pmc[k]));
const primeira = lerApresentacao(p.apresentacoes[0]!.apresentacao)?.legivel ?? p.apresentacoes[0]!.apresentacao;
const descricao = `${p.produto} (${p.laboratorio}), ${primeira}: quanto a farmácia pode cobrar em cada estado, na lista da CMED de ${publicado}.`;
const breadcrumb = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Remédios", item: new URL("/remedios/", Astro.site).href },
    {
      "@type": "ListItem",
      position: 2,
      name: p.substancia,
      item: new URL(`/remedios/substancia/${substanciaSlug}/`, Astro.site).href,
    },
    { "@type": "ListItem", position: 3, name: p.produto, item: new URL(Astro.url.pathname, Astro.site).href },
  ],
};
---

<Base title={`${p.produto}: preço máximo`} description={descricao} structured={[breadcrumb]}>
  <p class="trilha">
    <a href="/remedios/">Remédios</a> › <a href={`/remedios/substancia/${substanciaSlug}/`}>{p.substancia}</a>
  </p>
  <h1>{p.produto}</h1>
  <p class="ficha">
    <span>{p.laboratorio}</span>
    {p.tipo_produto && <Selo>{p.tipo_produto}</Selo>}
  </p>

  {aviso && (
    <Quadro tipo="alerta">
      <p>{aviso}</p>
    </Quadro>
  )}

  <p class="lead">{PRECO_MAXIMO}</p>
  <SeuEstado />

  {p.apresentacoes.map((a, i) => {
    const lida = lerApresentacao(a.apresentacao);
    const faixa = faixaPreco(a, cols);
    const barato = baratos[i];
    return (
      <section class="apres">
        <h2>{lida?.legivel ?? a.apresentacao}</h2>
        <p class="codigo">
          {lida && <>Na lista da CMED: {a.apresentacao}</>}
          {!a.comercializado && <Selo tom="alerta">sem venda no último ano</Selo>}
        </p>
        <p class="no-estado" data-so-com-estado hidden>
          No seu estado (<span data-uf-rotulo data-generico={generico || undefined} />
          ): até{" "}
          <strong data-precos={precos(a.pmc)} data-generico={generico || undefined}>
            {faixa}
          </strong>
        </p>
        {faixa && (
          <p class="faixa" data-so-sem-estado>
            {faixa}
          </p>
        )}
        <details data-recolher open>
          <summary>Preço máximo em cada estado</summary>
          <ul class="aliquotas" data-generico-lista={generico || undefined}>
            {cols
              .filter((k) => a.pmc[k] !== undefined)
              .map((k) => (
                <li data-aliquota={k}>
                  <span class="ufs">{ufs.get(k)?.join(", ") ?? "nenhum estado como padrão"}</span>
                  <span class="icms">ICMS {aliquotaRotulo(k)}</span>
                  <strong>{preco(a.pmc, k)}</strong>
                </li>
              ))}
          </ul>
        </details>
        {barato && (
          <p class="barato">
            <strong data-por-uf={JSON.stringify(rotulosPorUf(barato.menosPorUf, barato.menos))}>
              {maisBaratoRotulo(barato.menos)}
            </strong>{" "}
            com a mesma dose e embalagem: <a href={barato.href}>{barato.produto}</a>
            {barato.tipo && ` (${barato.tipo.toLowerCase()}, ${barato.laboratorio})`}, até{" "}
            <span data-precos={precos(barato.pmc)} data-generico={barato.tipo === "Genérico" || undefined}>
              {preco(barato.pmc, ref)}
            </span>{" "}
            (
            <span data-uf-rotulo data-generico={barato.tipo === "Genérico" || undefined}>
              ICMS {aliquotaRotulo(ref)}
            </span>
            ).
          </p>
        )}
      </section>
    );
  })}
  {aConfirmar && <p class="muted">* Estado com ICMS confirmado só por fontes não oficiais.</p>}
  <p class="muted">{SE_COBRAREM_MAIS}</p>

  <section>
    <h2>Sobre este remédio</h2>
    <ul>
      {tipo && <li>{tipo}</li>}
      {tarja && <li>{tarja}</li>}
      <li>
        Substância: <a href={`/remedios/substancia/${substanciaSlug}/`}>{p.substancia}</a>, com as outras marcas e os
        genéricos
      </li>
      {p.classe_terapeutica && <li>Grupo de remédios: {classeSemCodigo(p.classe_terapeutica)}</li>}
      <li>Registro na ANVISA: {p.registro_produto}</li>
    </ul>
  </section>

  <section class="fontes">
    <h2>Fontes</h2>
    <p>
      Lista de preços da CMED (ANVISA), publicada em {publicado}. O ICMS de cada estado e a lei de origem estão em{" "}
      <a href="/remedios/sobre-o-preco/">por que o preço muda de estado para estado</a>. Todos os números deste remédio,
      num arquivo só: <a href={`${CMED_DADOS_URL}/produto/${p.registro_produto}.json`}>JSON</a>.
    </p>
  </section>
</Base>

<style>
  .trilha {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 1.25rem 0 0;
  }
  .trilha a {
    color: var(--muted);
  }
  h1 {
    margin-top: 0.5rem;
  }
  .ficha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .apres {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 4px 18px 14px;
    margin: 1rem 0;
  }
  .apres h2 {
    font-size: 1.1rem;
    margin: 0.9rem 0 0.1rem;
  }
  .codigo {
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0 0 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    align-items: center;
  }
  .no-estado {
    font-size: 1.1rem;
  }
  .no-estado strong {
    font-size: 1.35rem;
  }
  .faixa {
    font-weight: 600;
  }
  details {
    margin: 0.5rem 0;
  }
  summary {
    cursor: pointer;
    color: var(--accent-ink);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .aliquotas {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
  }
  .aliquotas li {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 2px 14px;
    align-items: baseline;
    padding: 6px 8px;
    border-bottom: 1px solid var(--line);
    border-radius: 6px;
  }
  .aliquotas li:last-child {
    border-bottom: 0;
  }
  .aliquotas :global(li.sua) {
    background: var(--accent-soft);
    outline: 1px solid var(--accent);
  }
  .ufs {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .icms {
    font-size: 0.85rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .aliquotas strong {
    white-space: nowrap;
    text-align: right;
  }
  .barato {
    border-top: 1px dashed var(--line);
    padding-top: 0.6rem;
    margin-top: 0.6rem;
  }
</style>
