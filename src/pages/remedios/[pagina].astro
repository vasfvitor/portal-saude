---
// One page per product: what it is, then one block per dose and package with the maximum price in each state
// (a line per ICMS rate, with the states that use it), the price in the reader's state once they pick it, and the
// cheapest product with the same dose and package. Prices come from the CMED list as published; a price is never
// shown without its rate or its state next to it.
import Acompanhar from "../../components/Acompanhar.astro";
import Quadro from "../../components/Quadro.astro";
import Selo from "../../components/Selo.astro";
import SeuEstado from "../../components/SeuEstado.astro";
import Base from "../../layouts/Base.astro";
import { lerApresentacao } from "../../lib/apresentacao";
import {
  chaveComparacao,
  ehGenerico,
  maisBarato,
  porChave,
  precoNoRegime,
  quantoMenos,
  REGIMES,
} from "../../lib/comparar";
import { CMED_DADOS_URL } from "../../lib/config";
import { fmtStamp } from "../../lib/format";
import {
  acompanharSubstancia,
  aliquotaRotulo,
  avisoComercializacao,
  classeSemCodigo,
  faixaPreco,
  isentoDeIcms,
  PRECO_MAXIMO,
  precoMaximo,
  precosPorAliquota,
  SE_COBRAREM_MAIS,
  tarjaExplicada,
  TROCA_NA_FARMACIA,
  tipoExplicado,
  USO_HOSPITALAR,
} from "../../lib/frases-remedios";
import { TABELA, type Regime } from "../../lib/icms";
import {
  paginaProduto,
  pmcAplicavel,
  produtosForBuild,
  slugsSubstancias,
  type Apresentacao,
  type Produto,
} from "../../lib/remedios";

/** The cheapest product with the same dose and package, in one ICMS regime or in both (`regime` undefined). */
interface Barato {
  regime?: Regime;
  produto: string;
  laboratorio: string;
  tipo: string | null;
  href: string;
  pmc: Apresentacao["pmc"];
  /** whole percent less, at the rates each product pays in the regime (negative when it costs more) */
  menos: number;
  /** offered because this presentation is not on sale, not because it is cheaper */
  alternativa: boolean;
  /** the cheaper one is exempt from ICMS: one price in every state, shown without a rate */
  isento: boolean;
}

export async function getStaticPaths() {
  const produtos = await produtosForBuild(CMED_DADOS_URL);
  const substancias = slugsSubstancias(produtos.map((p) => p.substancia));
  const grupos = { p: porChave(produtos, "p"), g: porChave(produtos, "g") };
  const baratos = (p: Produto, a: Apresentacao): Barato[] => {
    const lida = lerApresentacao(a.apresentacao);
    if (!lida) return [];
    const porRegime = REGIMES.flatMap((regime): Barato[] => {
      const preco = precoNoRegime(p, a, regime);
      const o =
        preco === undefined
          ? undefined
          : // not on sale: the cheapest alternative on sale, even if it costs more
            maisBarato(
              grupos[regime].get(chaveComparacao(p, lida)),
              p.registro_produto,
              a.comercializado ? preco : undefined,
            );
      if (!o || preco === undefined) return [];
      const { produto } = o;
      return [
        {
          regime,
          produto: produto.produto,
          laboratorio: produto.laboratorio,
          tipo: produto.tipo_produto,
          href: paginaProduto(produto),
          pmc: pmcAplicavel(o.apresentacao),
          menos: quantoMenos(preco, o.preco),
          alternativa: !a.comercializado,
          isento: o.apresentacao.icms_0,
        },
      ];
    });
    // the same answer in both regimes is shown once, for every state
    const [x, y] = porRegime;
    return x && y && x.href === y.href && x.menos === y.menos ? [{ ...x, regime: undefined }] : porRegime;
  };
  return produtos.map((p) => ({
    params: { pagina: paginaProduto(p).split("/")[2]! },
    props: { p, substanciaSlug: substancias.get(p.substancia)!, baratos: p.apresentacoes.map((a) => baratos(p, a)) },
  }));
}

interface Props {
  p: Produto;
  substanciaSlug: string;
  baratos: Barato[][];
}
const { p, substanciaSlug, baratos } = Astro.props;
const generico = ehGenerico(p);
const marca = generico ? "1" : "0";
const ufs = generico ? TABELA.ufs.generico : TABELA.ufs.normal;
const cols = generico ? TABELA.colunas.generico : TABELA.colunas.normal;
const aConfirmar = [...ufs.values()].flat().some((u) => u.endsWith("*"));
const ref = TABELA.ref;
const tipo = tipoExplicado(p.tipo_produto);
const tarja = tarjaExplicada(p.tarja);
const aviso = avisoComercializacao(p.comercializado);
const publicado = fmtStamp(p.stamp);
const primeira = lerApresentacao(p.apresentacoes[0]!.apresentacao)?.legivel ?? p.apresentacoes[0]!.apresentacao;
const descricao = `${p.produto} (${p.laboratorio}), ${primeira}: quanto a farmácia pode cobrar em cada estado, na lista da CMED de ${publicado}.`;
const breadcrumb = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Remédios", item: new URL("/remedios/", Astro.site).href },
    {
      "@type": "ListItem",
      position: 2,
      name: p.substancia,
      item: new URL(`/remedios/substancia/${substanciaSlug}/`, Astro.site).href,
    },
    { "@type": "ListItem", position: 3, name: p.produto, item: new URL(Astro.url.pathname, Astro.site).href },
  ],
};
---

<Base
  title={`${p.produto}: preço máximo`}
  description={descricao}
  structured={[breadcrumb]}
  feed={p.feed_substancia ? { href: p.feed_substancia, title: `${p.substancia}: preços da CMED` } : undefined}
>
  <p class="trilha">
    <a href="/remedios/">Remédios</a> › <a href={`/remedios/substancia/${substanciaSlug}/`}>{p.substancia}</a>
  </p>
  <h1>{p.produto}</h1>
  <p class="ficha">
    <span>{p.laboratorio}</span>
    {p.tipo_produto && <Selo>{p.tipo_produto}</Selo>}
  </p>

  {aviso && (
    <Quadro tipo="atencao">
      <p>{aviso}</p>
      {baratos.some((b) => b.some((x) => x.alternativa)) && (
        <p>Mais abaixo aparece um remédio com a mesma substância, dose e embalagem que teve venda no último ano.</p>
      )}
    </Quadro>
  )}

  <p class="lead">{PRECO_MAXIMO}</p>
  <SeuEstado />

  {p.apresentacoes.map((a, i) => {
    const lida = lerApresentacao(a.apresentacao);
    const faixa = faixaPreco(a, cols);
    // exempt from ICMS: one ceiling for the country, so no line per state and nothing for the picker to swap
    const isento = a.icms_0 ? precoMaximo(a.pmc, "0") : null;
    return (
      <section class="cartao" data-apres data-generico={marca}>
        <h2>{lida?.legivel ?? a.apresentacao}</h2>
        <p class="codigo">
          {lida && <>Como está na lista oficial: {a.apresentacao}</>}
          {!a.comercializado && <Selo tom="atencao">sem venda no último ano</Selo>}
          {a.restricao_hospitalar && <Selo tom="atencao">uso hospitalar</Selo>}
        </p>
        {a.restricao_hospitalar && <p>{USO_HOSPITALAR}</p>}
        {isento ? (
          <p class="faixa">{isentoDeIcms(isento)}</p>
        ) : (
          <>
            <p class="no-estado" data-so-com-estado>
              No seu estado (<span data-uf-rotulo />
              ): até <strong data-preco-da-lista>{faixa}</strong>
            </p>
            {faixa && (
              <p class="faixa" data-so-sem-estado>
                {faixa}
              </p>
            )}
            <details data-recolher open>
              <summary>Preço máximo em cada estado</summary>
              <ul class="linhas">
                {cols
                  .filter((k) => a.pmc[k] !== undefined)
                  .map((k) => (
                    <li data-aliquota={k}>
                      <span class="ufs">{ufs.get(k)?.join(", ") ?? "nenhum estado como padrão"}</span>
                      <span class="icms">ICMS {aliquotaRotulo(k)}</span>
                      <strong>{precoMaximo(a.pmc, k)}</strong>
                    </li>
                  ))}
              </ul>
            </details>
          </>
        )}
        {baratos[i]!.map((b) => (
          <p class="barato" data-so-regime={b.regime} data-generico={b.tipo === "Genérico" ? "1" : "0"}>
            <strong>{b.alternativa ? "Com venda no último ano" : "Opção mais barata"}</strong>, com a mesma dose e
            embalagem: <a href={b.href}>{b.produto}</a>
            {b.tipo && ` (${b.tipo.toLowerCase()}, ${b.laboratorio})`}, até{" "}
            {b.isento ? (
              <>{precoMaximo(b.pmc, ref)} (isento de ICMS, o mesmo em todos os estados)</>
            ) : (
              <>
                <span data-precos={precosPorAliquota(b.pmc)}>{precoMaximo(b.pmc, ref)}</span> (
                <span data-uf-rotulo>{`ICMS ${aliquotaRotulo(ref)}`}</span>)
              </>
            )}
            {b.menos >= 1 ? `: ${b.menos}% a menos.` : "."}
          </p>
        ))}
      </section>
    );
  })}
  {baratos.some((b) => b.length > 0) && <p class="muted">{TROCA_NA_FARMACIA}</p>}
  {aConfirmar && <p class="muted">* Estado com ICMS confirmado só por fontes não oficiais.</p>}
  <p class="muted">{SE_COBRAREM_MAIS}</p>

  <section>
    <h2>Sobre este remédio</h2>
    <ul>
      {tipo && <li>{tipo}</li>}
      {tarja && <li>{tarja}</li>}
      <li>
        Substância: <a href={`/remedios/substancia/${substanciaSlug}/`}>{p.substancia}</a>, com as outras marcas e os
        genéricos
      </li>
      {p.classe_terapeutica && <li>Grupo de remédios: {classeSemCodigo(p.classe_terapeutica)}</li>}
      <li>Registro na ANVISA: {p.registro_produto}</li>
    </ul>
  </section>

  {p.feed_substancia && (
    <Acompanhar
      titulo="Acompanhar os preços"
      avisa={acompanharSubstancia(p.substancia)}
      href={p.feed_substancia}
      rotulo={`Endereço do feed de ${p.substancia}`}
    />
  )}

  <section class="fontes">
    <h2>Fontes</h2>
    <p>
      Lista de preços da CMED (ANVISA), publicada em {publicado}. O ICMS de cada estado e a lei de origem estão em{" "}
      <a href="/remedios/sobre-o-preco/">por que o preço muda de estado para estado</a>. Todos os números deste remédio,
      num arquivo só: <a href={`${CMED_DADOS_URL}/produto/${p.registro_produto}.json`}>JSON</a>.
    </p>
  </section>
</Base>

<style>
  .ficha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .codigo {
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0 0 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    align-items: center;
  }
  .no-estado {
    font-size: 1.1rem;
  }
  .no-estado strong {
    font-size: 1.35rem;
  }
  .faixa {
    font-weight: 600;
  }
  details {
    margin: 0.5rem 0;
  }
  summary {
    cursor: pointer;
    color: var(--accent-ink);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .ufs {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .icms {
    font-size: 0.85rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .linhas strong {
    white-space: nowrap;
    text-align: right;
  }
  .barato {
    border-top: 1px dashed var(--line);
    padding-top: 0.6rem;
    margin-top: 0.6rem;
  }
</style>
