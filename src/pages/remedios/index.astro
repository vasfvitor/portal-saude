---
// The medicines section: search by brand, substância or laboratory, and what the maximum price means.
import Busca from "../../components/Busca.astro";
import Base from "../../layouts/Base.astro";
import { CMED_DADOS_URL } from "../../lib/config";
import { fmtInt, fmtStamp } from "../../lib/format";
import { PRECO_MAXIMO, SE_COBRAREM_MAIS } from "../../lib/frases-remedios";
import { indiceProdutosForBuild } from "../../lib/remedios";

const { stamp, produtos } = await indiceProdutosForBuild(CMED_DADOS_URL);
const publicado = fmtStamp(stamp);
const substancias = new Set(produtos.map((p) => p.substancia)).size;
---

<Base
  title="Remédios: quanto a farmácia pode cobrar"
  description="Preço máximo que a farmácia pode cobrar por cada remédio, por apresentação e por ICMS do estado, na lista oficial da CMED."
>
  <h1>Remédios: quanto a farmácia pode cobrar</h1>
  <p class="lead">
    {PRECO_MAXIMO} São {fmtInt(produtos.length)} remédios vendidos em farmácia, com {fmtInt(substancias)} substâncias,
    na lista de {publicado}.
  </p>
  <Busca
    indice="/remedios/busca.json"
    rotulo="Procure pelo nome do remédio, pela substância ou pelo laboratório"
    exemplo="ex.: dipirona, Neosaldina, EMS"
    nomes={["remédio", "remédios"]}
    todas={{ href: "/remedios/substancias/", texto: "Ver todas as substâncias, de A a Z" }}
  />

  <section>
    <h2>Antes de ir à farmácia</h2>
    <ul>
      <li>
        O preço máximo muda com o <strong>ICMS do seu estado</strong>. Na página de cada remédio, escolha o estado para
        ver o valor de lá.
      </li>
      <li>
        <strong>Genéricos e similares</strong> da mesma substância costumam custar bem menos. A página de cada remédio
        mostra o mais barato com a mesma dose e embalagem, e a página da substância põe todos lado a lado.
      </li>
      <li>{SE_COBRAREM_MAIS}</li>
    </ul>
    <p>
      <a href="/remedios/sobre-o-preco/">Por que o preço muda de estado para estado, com o ICMS de cada um</a>
    </p>
  </section>
</Base>
