---
// What the maximum price is, who sets it, why it changes by state, and the curated table of default ICMS rates
// with the source of each row.
import Base from "../../layouts/Base.astro";
import { fmtDate } from "../../lib/format";
import { aliquotaRotulo, PRECO_MAXIMO, SE_COBRAREM_MAIS } from "../../lib/frases-remedios";
import { ESTADOS_POR_NOME as estados } from "../../lib/icms";

const CMED_URL = "https://www.gov.br/anvisa/pt-br/assuntos/medicamentos/cmed";
const faq = [
  { q: "O que é o preço máximo?", a: PRECO_MAXIMO },
  {
    q: "Por que o preço muda de estado para estado?",
    a: "Porque o preço máximo já inclui o ICMS, um imposto que cada estado define. A CMED publica um preço para cada ICMS possível, e vale o do estado onde o remédio é vendido. Alguns remédios pagam ICMS diferente do padrão do estado: em São Paulo e Minas Gerais, por exemplo, os genéricos pagam 12%.",
  },
  { q: "E se a farmácia cobrar mais?", a: SE_COBRAREM_MAIS },
];
const faqLd = {
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};
---

<Base
  title="Preço máximo dos remédios e o ICMS de cada estado"
  description="O que é o preço máximo ao consumidor da CMED, por que ele muda com o ICMS de cada estado e qual ICMS cada estado cobra."
  structured={[faqLd]}
>
  <h1>Preço máximo e o ICMS de cada estado</h1>
  {faq.map(({ q, a }) => (
    <>
      <h2>{q}</h2>
      <p>{a}</p>
    </>
  ))}
  <p>
    A lista oficial e as regras estão na <a href={CMED_URL}>página da CMED, no site da ANVISA</a>.
  </p>

  <h2>O ICMS de cada estado para remédios</h2>
  {estados.length === 0 ? (
    <p class="muted">
      Tabela em revisão. Enquanto isso, a página de cada remédio mostra o preço em todas as alíquotas.
    </p>
  ) : (
    <>
      <p class="muted">
        O ICMS que cada estado cobra, em regra, sobre remédios, com a lei ou a página do governo de onde ele saiu.
        Alguns remédios pagam diferente; a observação diz quando sabemos. "A confirmar" quer dizer que só achamos a
        informação em fontes não oficiais. As Áreas de Livre Comércio têm preço próprio na lista da CMED e não estão
        aqui.
      </p>
      <div class="rolagem" tabindex="0" role="region" aria-label="ICMS por estado">
        <table>
          <thead>
            <tr>
              <th scope="col">Estado</th>
              <th scope="col" class="n">
                ICMS
              </th>
              <th scope="col">Observação</th>
              <th scope="col">Fonte</th>
            </tr>
          </thead>
          <tbody>
            {estados.map((e) => (
              <tr>
                <th scope="row">
                  {e.nome} ({e.uf})
                </th>
                <td class="n">
                  {aliquotaRotulo(e.aliquota)}
                  {!e.confirmado && <small class="duvida">a confirmar</small>}
                </td>
                <td>{e.observacao ?? ""}</td>
                <td>
                  <a href={e.fonte}>fonte</a>, conferida em {fmtDate(e.conferido_em)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}
</Base>

<style>
  .rolagem {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--card);
  }
  table {
    border-collapse: collapse;
    font-size: 0.9rem;
    min-width: 100%;
  }
  th,
  td {
    padding: 8px 10px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .n {
    text-align: right;
    white-space: nowrap;
  }
  @media (max-width: 40rem) {
    /* one block per state on a phone: name and rate on one line, note and source below */
    thead {
      display: none;
    }
    tr {
      display: grid;
      grid-template-columns: 1fr auto;
      padding: 10px 12px;
      border-bottom: 1px solid var(--line);
    }
    tr:last-child {
      border-bottom: 0;
    }
    th,
    td {
      display: block;
      padding: 2px 0;
      border: 0;
    }
    td:nth-child(3),
    td:nth-child(4) {
      grid-column: 1 / -1;
      font-size: 0.85rem;
      color: var(--muted);
    }
    td:nth-child(3):empty {
      display: none;
    }
  }
  .duvida {
    display: block;
    color: var(--alert);
  }
</style>
