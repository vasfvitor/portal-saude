---
// About: method, sources and what is left out. The FAQ is one array rendered both as text and as FAQPage
// JSON-LD, so the two never disagree.
import Base from "../layouts/Base.astro";
import { ANS_FEEDS_URL, DADOS_URL, REPOS } from "../lib/config";

const faq: { q: string; a: string }[] = [
  {
    q: "De onde vêm os dados?",
    a: "Dos dados abertos da ANS (Agência Nacional de Saúde Suplementar): cadastro das operadoras, reclamações, índice de desempenho (IDSS), ressarcimento ao SUS e a página de portabilidade especial. Eles são coletados todo dia e guardados com a data de cada coleta.",
  },
  {
    q: "O site dá nota para as operadoras?",
    a: "Não. Ele mostra fatos comparados: por exemplo, quantas reclamações a operadora recebe em relação às de mesmo porte. Cada número vem com a base e a fonte, para você tirar a conclusão.",
  },
  {
    q: "Por que a comparação é com operadoras do mesmo porte?",
    a: "Porque comparar uma operadora de milhões de clientes com uma de poucos milhares engana nos dois sentidos. O porte (pequeno, médio, grande) vem da própria ANS.",
  },
  {
    q: "O que é portabilidade especial?",
    a: "Quando a ANS decide que os clientes de uma operadora podem trocar de plano sem cumprir carência de novo, em geral porque a operadora está com problemas graves ou saindo do mercado.",
  },
  {
    q: "Os dados estão sempre em dia?",
    a: "Tão em dia quanto a ANS publica. Algumas informações chegam com semanas de atraso, e algumas séries a ANS parou de atualizar; quando é o caso, a página diz.",
  },
  {
    q: "Tem ligação com a ANS ou com alguma operadora?",
    a: "Não. É um projeto independente e gratuito, de código aberto. Os dados oficiais estão no site da ANS.",
  },
];
const faqLd = {
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};
---

<Base
  title="Sobre"
  description="Como o site funciona: de onde vêm os dados, como as comparações são feitas e o que fica de fora."
  structured={[faqLd]}
>
  <h1>Sobre</h1>
  <p class="lead">
    Um serviço público gratuito: respostas diretas a partir de dados abertos do governo, com a fonte de cada número.
  </p>

  <section>
    <h2>Como funciona</h2>
    <p>
      Todo dia, um robô baixa os dados abertos da ANS e guarda o que mudou (<a href={REPOS.ansFeeds}>ans-feeds</a>).
      Este site lê esses dados e escreve, para cada operadora, frases curtas com a comparação e a base. Nenhum número é
      digitado à mão.
    </p>
    <p>
      Os dados prontos ficam em <a href={`${DADOS_URL}/schema.md`}>{DADOS_URL.replace("https://", "")}</a>, e os eventos
      (cancelamentos, novos registros, direção técnica, portabilidade) também saem como feeds em
      <a href={ANS_FEEDS_URL}>{ANS_FEEDS_URL.replace("https://", "").replace(/\/$/, "")}</a>.
    </p>
  </section>

  <section>
    <h2>O que fica de fora, e por quê</h2>
    <ul>
      <li>
        <strong>Classificação prudencial (S1 a S4)</strong>: é um segmento por porte e perfil, usado pela ANS para
        regras de capital. Não é nota de saúde financeira, então não aparece como se fosse.
      </li>
      <li>
        <strong>Taxa de resolutividade, garantia de atendimento e penalidades</strong>: a ANS parou de atualizar essas
        séries. A página da operadora avisa.
      </li>
      <li>
        <strong>Contatos</strong> do cadastro (e-mail, telefone, representante): não são publicados aqui.
      </li>
    </ul>
  </section>

  <section>
    <h2>Perguntas frequentes</h2>
    {faq.map(({ q, a }) => (
      <>
        <h3>{q}</h3>
        <p>{a}</p>
      </>
    ))}
  </section>
</Base>
