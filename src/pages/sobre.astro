---
// About: method, sources and what is left out. The FAQ is one array rendered both as text and as FAQPage
// JSON-LD, so the two never disagree.
import Base from "../layouts/Base.astro";
import { ANS_FEEDS_URL, CMED_DADOS_URL, DADOS_URL, REPOS } from "../lib/config";

const faq: { q: string; a: string }[] = [
  {
    q: "De onde vêm os números?",
    a: "Os de planos de saúde vêm da ANS (Agência Nacional de Saúde Suplementar): cadastro das operadoras, reclamações, nota de desempenho, pagamentos ao SUS e a lista de portabilidade especial. Os de remédios vêm da lista de preços máximos da CMED, publicada pela ANVISA todo mês. Os dados da ANS são baixados todo dia; cada página diz a data.",
  },
  {
    q: "O site dá nota para as operadoras?",
    a: "Não. Ele mostra o número da operadora ao lado do número de uma operadora típica do mesmo porte, com a quantidade de reclamações e de clientes por trás. A conclusão fica com você.",
  },
  {
    q: "O que é a operadora típica?",
    a: "É a do meio quando todas as operadoras do mesmo porte são postas em ordem: metade fica acima dela, metade abaixo. O porte (pequeno, médio ou grande) é o que a própria ANS usa.",
  },
  {
    q: "Por que comparar com operadoras do mesmo porte?",
    a: "Porque uma operadora com milhões de clientes e outra com poucos milhares funcionam de jeitos muito diferentes. Comparar as duas diretamente engana nos dois sentidos.",
  },
  {
    q: "O preço do remédio é o que eu vou pagar?",
    a: "Não necessariamente. É o máximo que a farmácia pode cobrar no seu estado. Ela pode cobrar menos, e muitas cobram.",
  },
  {
    q: "Os dados podem estar atrasados?",
    a: "Podem. A ANS publica algumas informações semanas depois, e parou de atualizar algumas séries. Quando isso acontece, a página avisa.",
  },
  {
    q: "O site tem ligação com o governo ou com alguma empresa?",
    a: "Não. É um projeto independente e gratuito. Os dados oficiais estão nos sites da ANS e da ANVISA.",
  },
];
const faqLd = {
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, a }) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};
---

<Base
  title="Sobre"
  description="De onde vêm os números, como as comparações são feitas e o que fica de fora."
  structured={[faqLd]}
>
  <h1>Sobre</h1>
  <p class="lead">
    Este site junta números que a ANS e a ANVISA já publicam e mostra cada um com uma comparação que ajuda a entender. É
    gratuito e não tem ligação com as agências nem com empresas do setor.
  </p>

  <section>
    <h2>Como funciona</h2>
    <p>
      Todo dia, um programa baixa os dados da ANS e guarda o que mudou (<a href={REPOS.ansFeeds}>código aberto</a>).
      Todo mês, outro baixa a lista de preços da CMED. Este site lê esses dados e monta uma página por operadora e por
      remédio. Nenhum número é digitado à mão. A única tabela feita à mão é a do ICMS de cada estado, com a lei de
      origem em cada linha.
    </p>
    <p>
      Os dados prontos estão em <a href={`${DADOS_URL}/schema.md`}>{DADOS_URL.replace("https://", "")}</a> e em{" "}
      <a href={`${CMED_DADOS_URL}/schema.md`}>{CMED_DADOS_URL.replace("https://", "")}</a>. Cancelamentos, novos
      registros e portabilidades também saem como avisos em feed, em{" "}
      <a href={ANS_FEEDS_URL}>{ANS_FEEDS_URL.replace("https://", "").replace(/\/$/, "")}</a>.
    </p>
  </section>

  <section>
    <h2>O que fica de fora, e por quê</h2>
    <ul>
      <li>
        <strong>Classificação prudencial (S1 a S4)</strong>: separa as operadoras por tamanho para regras de reserva
        financeira. Não diz se a operadora vai bem ou mal, então não aparece aqui.
      </li>
      <li>
        <strong>Taxa de resolutividade, garantia de atendimento e penalidades</strong>: a ANS parou de atualizar. A
        página da operadora avisa.
      </li>
      <li>
        <strong>Telefone, e-mail e representante</strong> do cadastro das operadoras: não são publicados aqui.
      </li>
    </ul>
  </section>

  <section>
    <h2>Perguntas frequentes</h2>
    {faq.map(({ q, a }) => (
      <>
        <h3>{q}</h3>
        <p>{a}</p>
      </>
    ))}
  </section>
</Base>
