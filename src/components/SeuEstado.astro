---
// "Seu estado": a select of the 27 states, remembered in localStorage. The script sets data-uf and data-regime
// on <html> (CSS in Base.astro shows and hides by them) and swaps a few texts. The pages work without it: the
// select stays hidden and every list shows all rates. Which rate an element uses comes from the nearest
// data-generico="1|0" around it. Elements opt in with:
//   data-precos='{"17":"R$ 501,58",...}'  text becomes the price at the state's rate (precosPorAliquota)
//   data-aliquota="18"                    gets class "sua" when it is the state's rate
//   data-uf-rotulo                        becomes "SP, ICMS 18%"
// and, through CSS: data-so-com-estado, data-so-sem-estado, data-so-regime="p|g", and --ordem-g for lists.
import { ESTADOS_POR_NOME } from "../lib/icms";
---

<div class="seu-estado" hidden>
  <label for="uf">Seu estado</label>
  <select id="uf">
    <option value="">Escolha para ver o preço de lá</option>
    {ESTADOS_POR_NOME.map((e) => (
      <option value={e.uf}>{e.nome}</option>
    ))}
  </select>
  <p class="nota" data-so-com-estado>
    O site guarda a escolha só neste navegador. Alguns remédios têm ICMS diferente do padrão do estado.
  </p>
</div>

<script>
  import { aliquotaRotulo } from "../lib/frases-remedios";
  import { aliquotaPorUf, ESTADOS, regimeDoEstado } from "../lib/icms";

  // built into the shared script from icms.ts: the same table the pages were built with
  const POR_UF = { normal: aliquotaPorUf(false), generico: aliquotaPorUf(true) };
  const REGIME = Object.fromEntries(ESTADOS.map((e) => [e.uf, regimeDoEstado(e)]));
  const A_CONFIRMAR = new Set(ESTADOS.filter((e) => !e.confirmado).map((e) => e.uf));
  const CHAVE = "saude.uf";
  const originais = new WeakMap<Element, string>();
  const todos = <E extends Element = HTMLElement>(sel: string) => document.querySelectorAll<E>(sel);

  /** Sets the text, or puts back the one the page was built with. */
  function trocar(el: Element, texto: string | undefined) {
    if (!originais.has(el)) originais.set(el, el.textContent ?? "");
    el.textContent = texto ?? originais.get(el)!;
  }

  function aplicar(uf: string) {
    const raiz = document.documentElement;
    const regime = REGIME[uf];
    if (regime) Object.assign(raiz.dataset, { uf, regime });
    else for (const k of ["data-uf", "data-regime"]) raiz.removeAttribute(k);
    const aliquota = (el: Element) =>
      regime
        ? (el.closest("[data-generico]")?.getAttribute("data-generico") === "1" ? POR_UF.generico : POR_UF.normal)[uf]
        : undefined;

    for (const el of todos("[data-precos]")) {
      const a = aliquota(el);
      trocar(el, a ? (JSON.parse(el.dataset.precos ?? "{}") as Record<string, string>)[a] : undefined);
    }
    for (const el of todos("[data-aliquota]")) el.classList.toggle("sua", el.dataset.aliquota === aliquota(el));
    for (const el of todos("[data-uf-rotulo]")) {
      const a = aliquota(el);
      trocar(el, a ? `${uf}, ICMS ${aliquotaRotulo(a)}${A_CONFIRMAR.has(uf) ? ", a confirmar" : ""}` : undefined);
    }
  }

  const caixa = document.querySelector<HTMLDivElement>(".seu-estado");
  const select = caixa?.querySelector("select");
  if (caixa && select) {
    let uf = "";
    try {
      uf = localStorage.getItem(CHAVE) ?? "";
    } catch {
      /* storage blocked: start without a state */
    }
    caixa.hidden = false;
    select.value = uf in REGIME ? uf : "";
    aplicar(select.value);
    select.addEventListener("change", () => {
      try {
        if (select.value) localStorage.setItem(CHAVE, select.value);
        else localStorage.removeItem(CHAVE);
      } catch {
        /* private mode: the choice lasts for this page only */
      }
      aplicar(select.value);
    });
  }
</script>

<style>
  .seu-estado {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 12px 16px;
    margin: 1rem 0 1.25rem;
  }
  .seu-estado[hidden] {
    display: none;
  }
  label {
    font-weight: 700;
  }
  select {
    font: inherit;
    padding: 8px 10px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--fg);
    min-width: 14rem;
    max-width: 100%;
  }
  .nota {
    flex-basis: 100%;
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
