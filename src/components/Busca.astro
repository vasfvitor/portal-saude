---
// Operator search: the site's only client JavaScript. Without it the link to the A-Z list still works.
// The index (/plano/busca.json) loads on first focus; matching ignores accents and case, every word must
// appear in the name, legal name, city, state or registration; names that start with the query come first.
---

<div class="busca">
  <label for="q" class="sr-only">
    Nome da operadora, cidade ou registro na ANS
  </label>
  <input id="q" type="search" autocomplete="off" placeholder="Nome da operadora, cidade ou registro na ANS" />
  <p class="estado" aria-live="polite"></p>
  <ul class="resultados"></ul>
  <p class="todas">
    <a href="/plano/todas/">Ver todas as operadoras, por estado</a>
  </p>
</div>

<script>
  interface Item {
    r: string;
    n: string;
    o?: string;
    m?: string;
    u?: string;
    c?: 1;
    h: string;
  }
  const MAX = 20;
  const norm = (s: string) => s.normalize("NFD").replace(/\p{M}/gu, "").toLowerCase();

  const root = document.querySelector<HTMLDivElement>(".busca");
  const input = root?.querySelector<HTMLInputElement>("input");
  const estado = root?.querySelector<HTMLParagraphElement>(".estado");
  const lista = root?.querySelector<HTMLUListElement>(".resultados");
  let itens: { item: Item; nome: string; texto: string }[] | null = null;
  let carregando: Promise<void> | null = null;

  const carregar = () =>
    (carregando ??= fetch("/plano/busca.json")
      .then((r) => r.json() as Promise<Item[]>)
      .then((dados) => {
        itens = dados.map((item) => ({
          item,
          nome: norm(item.n),
          texto: norm([item.n, item.o, item.m, item.u, item.r].filter(Boolean).join(" ")),
        }));
      })
      .catch(() => {
        if (estado) estado.textContent = "Não foi possível carregar a busca. Use a lista por estado.";
      }));

  function mostrar() {
    if (!input || !estado || !lista) return;
    const q = norm(input.value.trim());
    lista.replaceChildren();
    if (q.length < 2 || !itens) {
      estado.textContent = "";
      return;
    }
    const termos = q.split(/\s+/);
    const achados = itens
      .filter((x) => termos.every((t) => x.texto.includes(t)))
      .sort((a, b) => Number(b.nome.startsWith(q)) - Number(a.nome.startsWith(q)) || a.nome.localeCompare(b.nome));
    estado.textContent =
      achados.length === 0
        ? "Nenhuma operadora encontrada."
        : achados.length > MAX
          ? `${achados.length} operadoras; mostrando ${MAX}. Digite mais para filtrar.`
          : `${achados.length} ${achados.length === 1 ? "operadora" : "operadoras"}.`;
    for (const { item } of achados.slice(0, MAX)) {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = item.h;
      a.textContent = item.n;
      const info = document.createElement("span");
      info.className = "info";
      info.textContent = [
        item.m && item.u ? `${item.m}/${item.u}` : item.u,
        `registro ${item.r}`,
        item.c && "cancelada",
      ]
        .filter(Boolean)
        .join(" · ");
      li.append(a, " ", info);
      lista.append(li);
    }
  }

  input?.addEventListener("focus", () => void carregar(), { once: true });
  input?.addEventListener("input", () => {
    void carregar().then(mostrar);
  });
</script>

<style>
  .busca {
    max-width: 40rem;
    margin: 0 0 1.5rem;
  }
  input {
    width: 100%;
    font: inherit;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--card);
    color: var(--fg);
    box-shadow: var(--shadow);
  }
  input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .estado {
    color: var(--muted);
    font-size: 0.9rem;
    min-height: 1.4em;
  }
  .resultados {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .resultados :global(li) {
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }
  .resultados :global(.info) {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .todas {
    font-size: 0.95rem;
  }
</style>
