---
// Search box: the site's only client JavaScript. Without it the link to the full list still works.
// The index (JSON list of {n name, d detail line, t extra search text, h href}) loads on first focus;
// matching ignores accents and case, every word must appear in the name or the extra text; names that start
// with the query come first.
interface Props {
  /** path of the JSON index, e.g. /plano/busca.json */
  indice: string;
  /** visible label above the box */
  rotulo: string;
  /** short placeholder that fits a phone: "ex.: Unimed, Amil" */
  exemplo: string;
  /** singular and plural noun for the count line: ["operadora", "operadoras"] */
  nomes: [string, string];
  todas: { href: string; texto: string };
}
const { indice, rotulo, exemplo, nomes, todas } = Astro.props;
---

<div class="busca" data-indice={indice} data-um={nomes[0]} data-varios={nomes[1]}>
  <label for="q">{rotulo}</label>
  <input id="q" type="search" autocomplete="off" enterkeyhint="search" placeholder={exemplo} />
  <p class="estado" aria-live="polite"></p>
  <ul class="resultados"></ul>
  <p class="todas">
    <a href={todas.href}>{todas.texto}</a>
  </p>
</div>

<script>
  interface Item {
    n: string;
    d?: string;
    t?: string;
    h: string;
  }
  const MAX = 20;
  const norm = (s: string) => s.normalize("NFD").replace(/\p{M}/gu, "").toLowerCase();

  const root = document.querySelector<HTMLDivElement>(".busca");
  const input = root?.querySelector<HTMLInputElement>("input");
  const estado = root?.querySelector<HTMLParagraphElement>(".estado");
  const lista = root?.querySelector<HTMLUListElement>(".resultados");
  const um = root?.dataset.um ?? "resultado";
  const varios = root?.dataset.varios ?? "resultados";
  let itens: { item: Item; nome: string; texto: string }[] | null = null;
  let carregando: Promise<void> | null = null;

  const carregar = () =>
    (carregando ??= fetch(root?.dataset.indice ?? "")
      .then((r) => r.json() as Promise<Item[]>)
      .then((dados) => {
        itens = dados.map((item) => ({ item, nome: norm(item.n), texto: norm(`${item.n} ${item.t ?? ""}`) }));
      })
      .catch(() => {
        if (estado) estado.textContent = "Não foi possível carregar a busca. Use a lista completa.";
      }));

  function mostrar() {
    if (!input || !estado || !lista) return;
    const q = norm(input.value.trim());
    lista.replaceChildren();
    if (q.length < 2 || !itens) {
      estado.textContent = "";
      return;
    }
    const termos = q.split(/\s+/);
    const achados = itens
      .filter((x) => termos.every((t) => x.texto.includes(t)))
      .sort((a, b) => Number(b.nome.startsWith(q)) - Number(a.nome.startsWith(q)) || a.nome.localeCompare(b.nome));
    estado.textContent =
      achados.length === 0
        ? "Nada encontrado."
        : achados.length > MAX
          ? `${achados.length} ${varios}; mostrando ${MAX}. Digite mais para filtrar.`
          : `${achados.length} ${achados.length === 1 ? um : varios}.`;
    for (const { item } of achados.slice(0, MAX)) {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = item.h;
      a.textContent = item.n;
      li.append(a);
      if (item.d) {
        const info = document.createElement("span");
        info.className = "info";
        info.textContent = item.d;
        li.append(info);
      }
      lista.append(li);
    }
  }

  input?.addEventListener("focus", () => void carregar(), { once: true });
  input?.addEventListener("input", () => {
    void carregar().then(mostrar);
  });
</script>

<style>
  .busca {
    max-width: 40rem;
    margin: 0 0 1.5rem;
  }
  label {
    display: block;
    font-weight: 600;
    margin: 0 0 6px;
  }
  input {
    width: 100%;
    font: inherit;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--card);
    color: var(--fg);
  }
  input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .estado {
    color: var(--muted);
    font-size: 0.9rem;
    min-height: 1.4em;
  }
  .resultados {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .resultados :global(li) {
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }
  .resultados :global(.info) {
    display: block;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .todas {
    font-size: 0.95rem;
  }
</style>
