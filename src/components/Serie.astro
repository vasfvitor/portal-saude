---
// Quarterly complaint index as small SVG bars, with the peers' median as a dashed line. The aria-label reads
// the values out, so the chart says the same to a screen reader.
import { fmtDec } from "../lib/format";
import { trimestreCurto } from "../lib/frases";
import type { PontoSerie } from "../lib/operadoras";

interface Props {
  serie: PontoSerie[];
  mediana: number | null;
}
const { serie, mediana } = Astro.props;
const valores = serie.map((p) => p.indice ?? 0);
const max = Math.max(...valores, mediana ?? 0, 1);
const W = 320;
const H = 120;
const base = H - 22;
const passo = W / Math.max(serie.length, 1);
const barra = Math.min(28, passo * 0.6);
const y = (v: number) => base - (v / max) * (base - 8);
const rotulo = serie
  .map((p) => `${trimestreCurto(p.trimestre)}: ${p.indice === null ? "sem dado" : fmtDec(p.indice, 1)}`)
  .join("; ");
const aria = `Reclamações por 100 mil beneficiários por mês, por trimestre. ${rotulo}.${mediana === null ? "" : ` Plano típico do mesmo porte: ${fmtDec(mediana, 1)}.`}`;
---

{serie.length > 1 && (
  <figure class="serie">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={aria}>
      {serie.map((p, i) => {
        const x = i * passo + (passo - barra) / 2;
        const v = p.indice ?? 0;
        return (
          <>
            <rect
              x={x}
              y={y(v)}
              width={barra}
              height={Math.max(base - y(v), 1)}
              rx="3"
              class={i === serie.length - 1 ? "atual" : ""}
            />
            <text x={x + barra / 2} y={H - 6} text-anchor="middle">
              {trimestreCurto(p.trimestre)}
            </text>
          </>
        );
      })}
      {mediana !== null && <line x1="0" x2={W} y1={y(mediana)} y2={y(mediana)} class="mediana" />}
    </svg>
    <figcaption>
      Reclamações por 100 mil beneficiários por mês. {mediana !== null && "Tracejado: plano típico do mesmo porte."}
    </figcaption>
  </figure>
)}

<style>
  .serie {
    margin: 0.5rem 0 0;
    max-width: 26rem;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
  }
  rect {
    fill: var(--line);
  }
  rect.atual {
    fill: var(--accent);
  }
  text {
    font-size: 9px;
    fill: var(--muted);
  }
  .mediana {
    stroke: var(--fg);
    stroke-width: 1;
    stroke-dasharray: 4 3;
    opacity: 0.6;
  }
  figcaption {
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 4px;
  }
</style>
