---
// One comparison: the sentence in bold, the two numbers as bars when there is a comparison, this operator's
// numbers below, and what the measure means behind a closed question. The tone only colours the left border and
// this operator's bar.
import type { Frase } from "../lib/frases";
import Comparacao from "./Comparacao.astro";

interface Props {
  frase: Frase;
}
const { frase } = Astro.props;
---

<div class={`frase ${frase.tom}`}>
  <p class="titulo">{frase.titulo}</p>
  {frase.comparacao && <Comparacao c={frase.comparacao} tom={frase.tom} />}
  {frase.detalhe && <p class="detalhe">{frase.detalhe}</p>}
  <slot />
  {frase.explica && (
    <details class="explica">
      <summary>{frase.explica.pergunta}</summary>
      <p>{frase.explica.texto}</p>
    </details>
  )}
</div>

<style>
  .frase {
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 4px solid var(--line);
    border-radius: 10px;
    padding: 14px 18px;
    margin: 0.75rem 0;
  }
  .frase.favoravel {
    border-left-color: var(--good);
  }
  .frase.desfavoravel {
    border-left-color: var(--alert);
  }
  .frase.neutro {
    border-left-color: var(--neutral);
  }
  .titulo {
    font-weight: 600;
    margin: 0;
  }
  .detalhe {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0.4rem 0 0;
  }
  .explica {
    margin-top: 0.5rem;
    border-top: 1px dashed var(--line);
  }
  .explica summary {
    cursor: pointer;
    padding: 8px 0 0;
    min-height: 32px;
    color: var(--accent-ink);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .explica p {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0.3rem 0 0;
  }
</style>
